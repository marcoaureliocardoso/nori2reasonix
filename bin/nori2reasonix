#!/usr/bin/env node

import { parseArgs, usageText } from "../dist/src/cli/args.js";
import { runCli } from "../dist/src/cli/run.js";
import { runDoctor } from "../dist/src/doctor/run.js";
import { planSync } from "../dist/src/sync/plan.js";
import { executeSync } from "../dist/src/sync/run.js";
import { planClean } from "../dist/src/clean/plan.js";
import { executeClean } from "../dist/src/clean/run.js";
import { readFileSync } from "node:fs";
import path from "node:path";

let options;
try {
  options = parseArgs(process.argv.slice(2));
} catch (error) {
  const message = error instanceof Error ? error.message : String(error);
  console.error(`${message}\n\n${usageText()}`);
  process.exitCode = 2;
  process.exit();
}

if (options.help) {
  console.log(usageText());
  process.exitCode = 0;
} else if (options.doctor) {
  const report = runDoctor({ workspace: process.cwd() });
  console.log(JSON.stringify(report, null, 2));
  if (report.error !== undefined) {
    console.error(`nori2reasonix doctor: ${report.error}`);
  }
  const summary = report.entries.reduce(
    (acc, e) => {
      acc[e.status] = (acc[e.status] ?? 0) + 1;
      return acc;
    },
    {}
  );
  console.error(
    `nori2reasonix doctor: ${report.entries.length} skill(s) checked:`,
    JSON.stringify(summary)
  );
  process.exitCode = report.exitCode;
} else if (options.sync) {
  const report = runDoctor({ workspace: process.cwd() });
  const actions = planSync(report.entries);
  const sourceSkillDir =
    report.source.noriJsonPath !== undefined &&
    report.source.noriJsonPath !== ""
      ? report.source.noriJsonPath.replace(/nori\.json$/, "skills")
      : undefined;
  const result = executeSync(actions, {
    output: options.output || process.cwd(),
    yes: options.yes,
    force: options.force,
    sourceSkillDir,
  });

  console.log(JSON.stringify(result, null, 2));
  if (!result.executed) {
    console.error(
      `nori2reasonix sync: DRY-RUN — ${actions.length} action(s) planned (use --yes to execute)`
    );
  } else {
    console.error(
      `nori2reasonix sync: executed — ${result.written.length} written, ` +
        `${result.backupPaths.length} backed up, ${result.skipped.length} skipped`
    );
  }
  process.exitCode = report.exitCode === 3 ? 3 : result.executed ? 0 : 0;
} else if (options.clean) {
  const output = options.output || process.cwd();
  const report = runDoctor({ workspace: output });

  // Owned = keys of .nori2reasonix.json (things the converter wrote).
  const owned = new Set();
  try {
    const raw = JSON.parse(
      readFileSync(path.join(output, ".nori2reasonix.json"), "utf8")
    );
    const files = raw.files ?? {};
    for (const key of Object.keys(files)) {
      if (key.startsWith(".reasonix/skills/") && key.endsWith("/SKILL.md")) {
        owned.add(key.split("/")[2] ?? "");
      }
    }
  } catch {
    // No ownership manifest yet — nothing is "ours".
  }

  const candidates = planClean(owned, report.entries);
  const result = executeClean(candidates, {
    output,
    yes: options.yes,
    force: options.force,
  });

  console.log(JSON.stringify(result, null, 2));
  if (!result.executed) {
    console.error(
      `nori2reasonix clean: DRY-RUN — ${candidates.length} skill(s) would be removed (use --yes to execute)`
    );
  } else {
    console.error(
      `nori2reasonix clean: removed ${result.written.length}, ` +
        `${result.backupPaths.length} backed up, ${result.skipped.length} skipped`
    );
  }
  process.exitCode = 0;
} else {
  const result = runCli(options);

  if (result.error !== undefined) {
    console.error(`nori2reasonix: ${result.error}`);
  }

  if (result.summary.warnings.length > 0) {
    console.error(
      `nori2reasonix: ${result.summary.warnings.length} warning(s):`
    );
    for (const warning of result.summary.warnings) {
      console.error(
        `  - ${warning.entity}.${warning.field}: ${warning.detail}`
      );
    }
  }

  if (result.summary.written.length > 0) {
    console.log(`nori2reasonix: wrote ${result.summary.written.length} file(s)`);
  }
  if (result.summary.skipped.length > 0) {
    console.log(
      `nori2reasonix: skipped ${result.summary.skipped.length} user file(s)`
    );
  }

  process.exitCode = result.exitCode;
}
